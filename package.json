{
  "name": "municaodb-premium",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,VITE,QR -c blue,green,cyan \"node --env-file=.env api.js\" \"vite\" \"node qr-dev.js\"",
    "dev:cel": "concurrently -n API,VITE,NGROK -c blue,green,magenta \"node --env-file=.env api.js\" \"vite\" \"node --env-file=.env tunel-app.js\"",
    "cel": "vite build && concurrently -n API,APP,QR -c blue,green,cyan \"node --env-file=.env api.js\" \"vite preview\" \"node qr-dev.js\"",
    "start": "node --env-file=.env server.js",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/network": "^8.0.1",
    "@ngrok/ngrok": "^1.7.0",
    "@supabase/supabase-js": "^2.107.0",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "express": "^5.2.1",
    "framer-motion": "^12.23.24",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.511.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
