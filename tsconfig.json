{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // Permite `import ... from "./x.ts"` com extensão explícita. Necessário para
    // que scripts/ (fora do include, rodados por `node` com type-stripping nativo)
    // consigam importar módulos de src/ — o Node ESM exige a extensão, o Vite não.
    // Só é válido junto com noEmit: true. Não obriga ninguém: os imports sem
    // extensão do resto do código continuam funcionando igual.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
