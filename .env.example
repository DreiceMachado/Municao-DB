# Copie este arquivo para .env e preencha com os dados do servidor.
# copy .env.example .env   (Windows)

# URL PUBLICA do Supabase.
#  - Mesma rede Wi-Fi:  http://192.168.0.5:8000
#  - Outra internet:    https://SEU-DOMINIO.ngrok-free.app   (dominio fixo do ngrok)
VITE_SUPABASE_URL=https://crayon-embark-shakable.ngrok-free.dev
VITE_SUPABASE_ANON_KEY=coloque_a_anon_key_do_servidor_aqui

# Auto-login no BalísticaDB (deixe em branco para mostrar tela de login)
VITE_LOGIN_EMAIL=
VITE_LOGIN_PASSWORD=

# Token do Ngrok (obtenha em https://dashboard.ngrok.com/authtokens)
NGROK_AUTHTOKEN=

# Credenciais do sistema GDL (usado pela automação de REP)
GDL_USUARIO=
GDL_SENHA=
